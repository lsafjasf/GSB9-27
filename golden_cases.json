      "name": "A1_平衡样本_正常预测",
      "alpha": 1.0,
      "class_prior": "uniform",
      "train": [
        {
          "doc": [
            "buy",
            "cheap",
            "money"
          ],
          "label": "spam"
        },
        {
          "doc": [
            "cheap",
            "money",
            "deal"
          ],
          "label": "spam"
        },
        {
          "doc": [
            "meeting",
            "project",
            "team"
          ],
          "label": "ham"
        },
        {
          "doc": [
            "project",
            "team",
            "schedule"
          ],
          "label": "ham"
        }
      ],
      "doc": [
        "cheap",
        "money"
      ],
      "expected": {
        "label": "spam",
        "scores_frac": {
          "ham": [
            1,
            392
          ],
          "spam": [
            9,
            392
          ]
        },
        "手算": "spam: 1/2 * (3/14) * (3/14) = 9/392; ham: 1/2 * (1/14) * (1/14) = 1/392"
      }
    },
