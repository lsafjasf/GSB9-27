{
  "name": "prod-security-baseline",
  "version": "1.3.0",
  "valid_until": "2026-06-30",
  "rules": [
    {
      "id": "ssh-password-auth",
      "key": "ssh.password_auth",
      "requirement": "SSH 必须禁用口令登录",
      "op": "eq",
      "expect": false,
      "severity": "critical",
      "since": "1.0.0",
      "remediation": "在最高优先级来源中设置 ssh.password_auth=false，并清理低优先级来源中的反向覆盖"
    },
    {
      "id": "ssh-permit-root-login",
      "key": "ssh.permit_root_login",
      "requirement": "SSH 必须禁止 root 直登",
      "op": "eq",
      "expect": false,
      "severity": "critical",
      "since": "1.0.0",
      "remediation": "设置 ssh.permit_root_login=false，改用普通账号 + sudo"
    },
    {
      "id": "tls-min-version",
      "key": "tls.min_version",
      "requirement": "TLS 最低版本必须为 1.2 或 1.3",
      "op": "in",
      "expect": ["1.2", "1.3"],
      "severity": "error",
      "since": "1.1.0",
      "remediation": "将 tls.min_version 提升为 1.2 或 1.3，并禁用旧协议"
    },
    {
      "id": "session-timeout",
      "key": "session.timeout_minutes",
      "requirement": "会话超时不得超过 30 分钟",
      "op": "le",
      "expect": 30,
      "severity": "warning",
      "since": "1.1.0",
      "remediation": "将 session.timeout_minutes 调整为 <= 30"
    },
    {
      "id": "logging-audit",
      "key": "logging.audit_enabled",
      "requirement": "必须开启审计日志",
      "op": "eq",
      "expect": true,
      "severity": "error",
      "since": "1.2.0",
      "remediation": "设置 logging.audit_enabled=true 并确认日志落盘"
    },
    {
      "id": "mfa-required",
      "key": "mfa.required",
      "requirement": "必须强制多因素认证",
      "op": "eq",
      "expect": true,
      "severity": "error",
      "missing_severity": "error",
      "since": "1.3.0",
      "remediation": "在任一配置来源中显式设置 mfa.required=true（本规则为 v1.3.0 新增，历史配置通常缺失）"
    },
    {
      "id": "password-min-length",
      "key": "password.min_length",
      "requirement": "密码最小长度不得小于 12",
      "op": "ge",
      "expect": 12,
      "severity": "warning",
      "since": "1.3.0",
      "remediation": "将 password.min_length 提升至 >= 12"
    }
  ]
}
